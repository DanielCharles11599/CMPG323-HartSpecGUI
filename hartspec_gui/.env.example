# Copy this file to .env (same folder) and fill in YOUR local paths.
# .env is loaded automatically by Home.py, utils/fits_ingest.py, and
# tests/conftest.py -- you don't need to set these in the terminal each time.
#
# Add .env to .gitignore -- don't commit your real local paths.

# Overrides utils.fits_ingest.get_archive_root(). Where the app looks for
# FITS files instead of the production /data/fits/ path, which won't exist
# on a dev machine.
HARTSPEC_FITS_ARCHIVE_ROOT=C:./data/fits

# Opt-in for tests/conftest.py's real_fits_archive fixture. Points tests
# that use it (currently in test_02_File_Loader.py) at real HartRAO files
# instead of synthetic ones. Tests using this fixture are skipped
# automatically if this isn't set -- safe to leave blank/unset.
HARTSPEC_REAL_FITS_DIR=C:./data/fits